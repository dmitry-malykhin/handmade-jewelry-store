// ─────────────────────────────────────────────────────────────────────────────
// Prisma schema — Handmade Jewelry Store
// Issue #62: User, Product, Category, Order, OrderItem, Payment
// Issue #63: Review, Wishlist + seed script
// Issue #116: OrderStatus (PROCESSING, REFUNDED), StockType, CancelReason,
//             OrderStatusHistory, extended Order + OrderItem fields
// Issue #75:  ProductStatus enum (ACTIVE/DRAFT/ARCHIVED) + status field on Product
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING            // Order created, awaiting payment confirmation
  PAID               // Payment confirmed via Stripe webhook
  PROCESSING         // Item being packed or manufactured
  SHIPPED            // Tracking number added, parcel dispatched
  DELIVERED          // Confirmed by customer or auto after 14 days
  CANCELLED          // Order cancelled (allowed before SHIPPED)
  REFUNDED           // Full refund executed via Stripe
  PARTIALLY_REFUNDED // Partial refund — e.g. MADE_TO_ORDER cancelled mid-production
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ProductStatus {
  ACTIVE   // Visible in catalog and search
  DRAFT    // Hidden from public catalog, editable by admin
  ARCHIVED // Discontinued, hidden from catalog, read-only
}

enum StockType {
  IN_STOCK      // Ready item on shelf — ships in 1-2 days
  MADE_TO_ORDER // Made after payment — productionDays applies
  ONE_OF_A_KIND // Unique piece, 1 unit, ships like IN_STOCK
}

enum CancelReason {
  CUSTOMER_REQUEST // Customer changed their mind
  DUPLICATE_ORDER  // Customer placed the same order twice
  OUT_OF_STOCK     // Materials unavailable (force majeure)
  PAYMENT_FAILED   // Technical payment failure
  SHIPPING_ISSUE   // Delivery problem
  ITEM_DAMAGED     // Defect found before shipment (handmade-specific)
  FRAUD_SUSPECTED  // Fraud signal
  OTHER
}

enum RefundReason {
  ITEM_DAMAGED          // Damage in transit or quality issue
  ITEM_NOT_AS_DESCRIBED // Mismatch with product description
  CUSTOMER_CHANGED_MIND // Return-policy refund
  DUPLICATE_ORDER       // Customer paid twice for same order
  OTHER
}

enum ProductionStatus {
  QUEUED         // Paid, not yet started — default for orders with MTO items
  IN_PRODUCTION  // Maker actively crafting the piece
  READY_TO_SHIP  // Finished, awaiting tracking number / dispatch
}

enum DiscountType {
  PERCENTAGE   // value is 1-100, applied as percent off subtotal
  FIXED_AMOUNT // value is in cents, flat $ off
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  password             String
  role                 Role           @default(USER)
  // Hashed password reset token — cleared after use or expiry (1h window)
  passwordResetToken   String?
  passwordResetTokenAt DateTime?
  refreshTokens        RefreshToken[]
  orders               Order[]
  reviews              Review[]
  wishlist             Wishlist?
  addresses            Address[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

// Saved shipping addresses for returning customers.
// Field names match the ShippingAddress JSON snapshot stored on Order so the same
// frontend types can be reused. isDefault marks the address pre-selected at checkout —
// service ensures only one address per user has isDefault=true.
model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  country      String   @default("US")
  phone        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// One row per active session — replaces the single refreshToken field on User.
// Multiple devices can be logged in simultaneously. Token rotation deletes the
// old row and inserts a new one. Reuse detection deletes ALL rows for the user.
model RefreshToken {
  // ID is generated by the application (crypto.randomUUID) and embedded in the
  // JWT payload so we can do O(1) lookup without scanning all user tokens.
  id        String   @id
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique // mandatory for SEO URLs: /catalog/rings
  products Product[]
}

model Product {
  id             String     @id @default(cuid())
  title          String
  description    String
  price          Decimal    @db.Decimal(10, 2)
  // Binary stock — 0 (made on order) or 1 (one piece ready). DB-level CHECK constraint
  // installed in migration 20260501000000_stock_zero_or_one_check.
  stock          Int        @default(0)
  images         String[]   // S3 URLs, uploaded in Issue #21
  slug           String     @unique // mandatory for SEO URLs: /products/silver-ring
  sku            String?             // for Google Shopping feed
  weight         Float?              // grams, for shipping cost calculation
  material       String?             // "Sterling Silver 925"
  avgRating      Float      @default(0)
  reviewCount    Int        @default(0)
  status         ProductStatus @default(ACTIVE)
  stockType      StockType     @default(IN_STOCK)
  productionDays Int           @default(0) // 0 = in stock; 3-7 = made to order

  // Dimensions — stored in metric, converted to imperial at display time (docs/10)
  lengthCm    Float? // primary length: necklace, bracelet, lariat
  widthCm     Float? // item width or band width
  heightCm    Float? // pendant/cabochon height
  diameterCm  Float? // bangle-style bracelet inner diameter
  weightGrams Float? // display weight in grams (universal in jewelry — never convert)
  beadSizeMm  Float? // bead diameter in mm (industry standard — never convert)

  categoryId     String
  category       Category   @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  reviews        Review[]
  wishlists      Wishlist[] @relation("WishlistProducts")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Order {
  id              String        @id @default(cuid())
  userId          String?       // nullable: guest checkout supported
  user            User?         @relation(fields: [userId], references: [id])
  guestEmail      String?       // email for guest orders — used for confirmation emails
  status          OrderStatus   @default(PENDING)
  total           Decimal       @db.Decimal(10, 2)
  subtotal        Decimal       @db.Decimal(10, 2) // before discounts/shipping
  shippingCost    Decimal       @db.Decimal(10, 2) @default(0)

  // Shipping address — JSON snapshot at checkout time (not FK; address may change later)
  shippingAddress Json

  // Shipping tracking
  shippingCarrier     String?
  trackingNumber      String?
  shippedAt           DateTime?
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?

  // Cancellation
  cancelledAt  DateTime?
  cancelReason CancelReason?
  cancelNote   String?       // human-readable note shown to customer

  // Refund
  refundedAt   DateTime?
  refundAmount Decimal?      @db.Decimal(10, 2) // may be less than total (partial refund)
  refundReason RefundReason?
  refundNote   String?       // admin-facing internal note shown in refunds list

  // Production tracking — only meaningful when order contains MADE_TO_ORDER
  // items. Defaults to QUEUED so the admin /production board surfaces every
  // newly-paid MTO order without an explicit admin step.
  productionStatus ProductionStatus @default(QUEUED)
  productionNotes  String?          // admin-only context ("customer wants extra polish")

  // Loyalty points — Post-MVP; schema added now to avoid future migration
  loyaltyPointsUsed   Int @default(0) // 1 point = $0.01
  loyaltyPointsEarned Int @default(0) // credited only at DELIVERED

  // Analytics
  source String? // "web" | "admin"

  items         OrderItem[]
  payment       Payment?
  statusHistory OrderStatusHistory[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id])
  fromStatus OrderStatus? // null for the initial PENDING entry
  toStatus   OrderStatus
  note       String?      // admin comment
  createdBy  String?      // userId or "system" for automatic transitions
  createdAt  DateTime     @default(now())
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  productId       String?  // nullable: product may be deleted after order
  product         Product? @relation(fields: [productId], references: [id])
  productSnapshot Json     // { title, slug, sku, image } — snapshot at purchase time
  quantity        Int
  price           Decimal  @db.Decimal(10, 2) // snapshot of price at purchase time
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  order     Order         @relation(fields: [orderId], references: [id])
  stripeId  String        @unique // Stripe PaymentIntent ID
  status    PaymentStatus @default(PENDING)
  amount    Decimal       @db.Decimal(10, 2)
  createdAt DateTime      @default(now())
}

// Moderation lifecycle: PENDING (new) → APPROVED (visible on product page)
// or HIDDEN (spam/abusive — never shown). Only APPROVED reviews count in the
// public list; aggregates on Product (avgRating, reviewCount) follow the same
// rule so a hidden review immediately stops contributing to the average.
enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

model Review {
  id              String       @id @default(cuid())
  rating          Int          // 1–5 stars
  comment         String?
  status          ReviewStatus @default(PENDING)
  // Seller (admin) reply shown publicly under the customer review. Optional —
  // most reviews don't need a reply. `sellerRepliedAt` is set on first save
  // and updated on subsequent edits to support an "edited X days ago" hint.
  sellerReply     String?
  sellerRepliedAt DateTime?
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  productId       String
  product         Product      @relation(fields: [productId], references: [id])
  createdAt       DateTime     @default(now())

  @@unique([userId, productId]) // one review per user per product
  @@index([status])             // admin filter by status
}

model Wishlist {
  id       String    @id @default(cuid())
  userId   String    @unique // one wishlist per user
  user     User      @relation(fields: [userId], references: [id])
  products Product[] @relation("WishlistProducts")
}

// Discount / coupon codes (#164). Codes are normalised to UPPERCASE before
// store + lookup so customer-facing inputs are case-insensitive without
// needing a Postgres citext column.
model Discount {
  id            String       @id @default(cuid())
  code          String       @unique // UPPERCASE; service normalises on write/read
  type          DiscountType
  value         Int          // PERCENTAGE: 1-100, FIXED_AMOUNT: cents
  minOrderCents Int          @default(0) // 0 = no minimum
  maxUsages     Int?         // null = unlimited
  usageCount    Int          @default(0)
  expiresAt     DateTime?    // null = never expires
  isActive      Boolean      @default(true)
  // Soft delete keeps historical orders referencing the code while hiding
  // it from the admin list and rejecting it at the validate endpoint.
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// Singleton table for admin-editable store settings (#171). Enforced via a
// fixed id 'default' — service-layer upsert keeps exactly one row regardless
// of how many times settings are loaded.
model SiteSettings {
  id String @id @default("default")

  // General
  storeName    String @default("Senichka")
  tagline      String @default("Handmade Beaded Jewelry")
  contactEmail String @default("")
  supportEmail String @default("")

  // Social links — nullable so an unset platform shows blank in the form
  instagramUrl String?
  pinterestUrl String?
  facebookUrl  String?
  tiktokUrl    String?

  // Shipping & returns
  returnPolicyDays           Int @default(30)
  estimatedDeliveryMinDays   Int @default(3)
  estimatedDeliveryMaxDays   Int @default(7)
  freeShippingThresholdCents Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
