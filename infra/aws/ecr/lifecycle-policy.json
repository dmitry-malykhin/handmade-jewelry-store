{
  "rules": [
    {
      "rulePriority": 1,
      "description": "Expire untagged images after 7 days — likely abandoned builds",
      "selection": {
        "tagStatus": "untagged",
        "countType": "sinceImagePushed",
        "countUnit": "days",
        "countNumber": 7
      },
      "action": {
        "type": "expire"
      }
    },
    {
      "rulePriority": 2,
      "description": "Keep only the latest 30 SHA-tagged images — older are recoverable from git",
      "selection": {
        "tagStatus": "tagged",
        "tagPatternList": ["sha-*", "v*", "main-*"],
        "countType": "imageCountMoreThan",
        "countNumber": 30
      },
      "action": {
        "type": "expire"
      }
    }
  ]
}
