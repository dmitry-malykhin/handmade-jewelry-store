{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuthAndPush",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken",
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcrPushToHandmadeJewelryApiRepo",
      "Effect": "Allow",
      "Action": ["ecr:BatchGetImage", "ecr:DescribeImages"],
      "Resource": "arn:aws:ecr:*:*:repository/handmade-jewelry-api"
    },
    {
      "Sid": "EcsTaskDefinitionAndDeploy",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTaskDefinition",
        "ecs:RegisterTaskDefinition",
        "ecs:UpdateService",
        "ecs:DescribeServices"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassExecutionRoleToEcsTaskDef",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": [
        "arn:aws:iam::*:role/handmade-jewelry-store-ecs-task-execution-role",
        "arn:aws:iam::*:role/handmade-jewelry-store-ecs-task-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
