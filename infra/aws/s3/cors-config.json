{
  "CORSRules": [
    {
      "ID": "AllowAdminUploadsFromAppOrigins",
      "AllowedHeaders": ["*"],
      "AllowedMethods": ["PUT", "POST", "GET", "HEAD"],
      "AllowedOrigins": [
        "http://localhost:3100",
        "http://localhost:3000",
        "https://senichka.com",
        "https://www.senichka.com",
        "https://senichka.vercel.app"
      ],
      "ExposeHeaders": ["ETag"],
      "MaxAgeSeconds": 3000
    }
  ]
}
