# Copy to terraform.tfvars and edit. Never commit terraform.tfvars — it goes
# into .gitignore. Sensitive secrets (DB password, GitHub Actions keys) are
# generated by Terraform itself; you never type them here.

project_name = "handmade-jewelry-store"
environment  = "production"
aws_region   = "us-east-1"

# Networking ─────────────────────────────────────────────────────────────────
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]

# Database ───────────────────────────────────────────────────────────────────
db_instance_class       = "db.t3.micro"
db_name                 = "jewelry"
db_username             = "jewelry_app"
db_allocated_storage_gb = 20

# ECS ────────────────────────────────────────────────────────────────────────
ecs_task_cpu       = "256"
ecs_task_memory    = "512"
ecs_desired_count  = 1
api_container_port = 4000

# Auto-scaling — keep fleet average around the target %, with a ceiling so
# a runaway scale can't 10× the bill.
ecs_autoscale_max_capacity          = 4
ecs_autoscale_cpu_target_percent    = 70
ecs_autoscale_memory_target_percent = 75

# DNS — leave domain_name empty to skip ACM + Route53 entirely.
# manage_dns_in_aws = false means you'll keep DNS in your existing provider
# (Cloudflare etc.) and validate ACM certificates manually.
domain_name       = ""
manage_dns_in_aws = false

# Observability — empty disables the whole CloudWatch alarms + SNS module.
alarm_email = ""

# CORS — set this to the origins your admin UI uses for S3 presigned uploads.
cors_origins = [
  "http://localhost:3100",
  "http://localhost:3000",
  "https://senichka.com",
  "https://www.senichka.com",
  "https://senichka.vercel.app",
]
